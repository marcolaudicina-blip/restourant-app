{
  "name": "restourant-app",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @restourant/db generate",
    "db:migrate": "pnpm --filter @restourant/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
