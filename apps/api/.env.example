# Postgres connection string, or "pglite:./.data" for an embedded database during development.
DATABASE_URL=pglite:./.data
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Set to true when the API sits behind the web app's proxy (it forwards X-Forwarded-For).
TRUST_PROXY=false
